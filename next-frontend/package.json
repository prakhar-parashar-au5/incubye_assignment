{
  "name": "next-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "ACME Compensation Manager web app (Next.js App Router). Talks to express-backend through server code only.",
  "engines": {
    "node": "22.23.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run api:check && npm run lint && npm run typecheck && npm test",
    "api:generate": "node scripts/generate-api-contract.mjs",
    "api:check": "node scripts/generate-api-contract.mjs --check"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.73.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "openapi-typescript": "7.13.0",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
