{
  // Production build: source and command scripts only, never tests.
  // Output keeps the source layout: dist/src/... and dist/scripts/...
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": false,
    "declaration": false
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"]
}
