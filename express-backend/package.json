{
  "name": "acme-express-backend",
  "version": "0.1.0",
  "private": true,
  "description": "ACME compensation backend. Current milestones: source workbook generator, initial MySQL schema, and workbook seed.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "node --test \"test/*.test.js\"",
    "test:db": "node --test --test-concurrency=1 \"test/db/*.test.js\"",
    "db:up": "COMPOSE_DISABLE_ENV_FILE=1 docker compose up -d --wait",
    "db:down": "COMPOSE_DISABLE_ENV_FILE=1 docker compose down",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed-database.js",
    "generate:workbook": "node scripts/generate-workbook.js"
  },
  "dependencies": {
    "exceljs": "4.4.0",
    "mysql2": "3.24.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "jszip": "3.10.2"
  }
}
